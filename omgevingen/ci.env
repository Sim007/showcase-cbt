# Waarden van een CI-omgeving — geen versies.
#
# De CI-omgeving is efemeer: hij bestaat tijdens de pipeline-run en wordt daarna
# opgeruimd. Daarom houdt hij geen toestand en valt er niets te conformeren; wat er draait
# heb je net zelf neergezet.
#
# Andere poorten dan Test en Acceptatie, zodat een pipeline kan draaien terwijl die
# omgevingen omhoog staan.

PAYMENT_API_POORT=7081
ORDER_API_POORT=7082

# De stub neemt de servicenaam van de buur over.
PAYMENT_BASE_URL=http://payment-api:8081
STUB_POORT=7083
