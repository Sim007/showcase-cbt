# Waarden van de omgeving Test — geen versies.
#
# Wat hier staat is wat per omgeving verschilt: poorten, adressen, en straks secrets.
# Welke versie er draait staat niet hier maar in de release die je deployt; dat is de
# scheiding tussen chart, chartversie en values.
#
# Test heeft geen koppeling met de buitenwereld. Externe partijen staan er als stub.

PAYMENT_API_POORT=8081
ORDER_API_POORT=8082

# Binnen het compose-netwerk vindt Order zijn buur op de servicenaam. Op Test is dat het
# echte deelsysteem; op een CI-omgeving neemt de stub diezelfde naam over, zodat Order het
# verschil niet merkt.
PAYMENT_BASE_URL=http://payment-api:8081
