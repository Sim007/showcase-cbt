# Efemeer: hij bestaat tijdens de pipeline-run en wordt daarna opgeruimd. Daarom houdt hij
# geen toestand en valt er niets te conformeren; wat er draait heb je net zelf neergezet.
#
# Eigen poorten, zodat een pipeline kan draaien terwijl Test en Acceptatie omhoog staan en
# terwijl de CI-omgeving van een ander deelsysteem draait.

PAYMENT_API_POORT=7081
