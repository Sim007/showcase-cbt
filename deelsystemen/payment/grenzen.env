# De grenzen van dit deelsysteem, en zijn rol op elk ervan.
#
# De rol hoort bij de grens en niet bij het deelsysteem: in hoofdstuk 6 staat hier een
# tweede SERVEERT voor Payment -> Notification, en in hoofdstuk 7 een PINT voor de externe
# betaalprovider. De pipeline leest dit en leidt eruit af wat hij moet draaien.

# Contracten die dit deelsysteem serveert: <groep> <artifact> <versie>
SERVEERT="order-payment payment-api 1.0.0"

# Waar de pipeline hem bereikt binnen het omgevingsnetwerk.
INTERNE_URL="http://payment-api:8081"

# Waar hij zijn eigen spec aanbiedt, voor de drift-check. Van de host, want het script
# draait daar.
RUNTIME_SPEC_URL="http://localhost:7081/v3/api-docs"
