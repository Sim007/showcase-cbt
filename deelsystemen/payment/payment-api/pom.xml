<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Geen aggregator-pom boven deze: elk deelsysteem moet zelfstandig te bouwen en te
       releasen zijn. Een root-pom zou de builds weer aan elkaar knopen. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>cbt</groupId>
  <artifactId>payment-api</artifactId>
  <version>1.0.1</version>
  <name>payment-api</name>
  <description>Provider van de grens Order -&gt; Payment</description>

  <properties>
    <java.version>21</java.version>
    <!-- De contractlaag draait pas na de deploy, tegen een draaiend deelsysteem. Zonder
         deze uitsluiting faalt een gewone `mvn test` op een omgeving die er nog niet is.
         ci/verify-contract.sh schakelt hem weer in met -DexcludedGroups= -->
    <excludedGroups>contract</excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Levert de spec die deze implementatie op zijn runtime aanbiedt. Nodig voor de
         drift-check: zonder een spec uit de draaiende code valt er niets te vergelijken
         met wat er gepubliceerd is. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>2.9.0</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Houdt een response tegen de gepubliceerde spec. Nodig voor de geschreven
         contractverificatie: zonder validator zou de test zijn eigen verwachting
         opschrijven, en dan ligt de norm weer in de test in plaats van in het contract. -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>swagger-request-validator-core</artifactId>
      <version>3.0.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Schrijft de serviceversie uit deze pom in de image, zodat het
               info-endpoint hem naast de contractversie kan melden. Twee versies, twee
               betekenissen: zonder dat onderscheid leest niemand af of 1.1.0 over het
               deelsysteem of over de grens gaat. -->
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
