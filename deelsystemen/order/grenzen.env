# De grenzen van dit deelsysteem, en zijn rol op elk ervan.
#
# Order pint op het contract van Payment en serveert er zelf geen: zijn eigen API is geen
# grens, want daar wisselt geen eigenaarschap.

# Contracten waarop dit deelsysteem pint: <groep> <artifact> <versie>
PINT="order-payment payment-api 1.0.0"

INTERNE_URL="http://order-api:8082"

# De stub speelt de buur; zijn admin-API vertelt wat Order heeft verstuurd.
STUB_ADMIN_URL="http://payment-api:8081/__admin"
