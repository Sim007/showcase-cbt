# Deelsysteem Order, release 1.0.0.
#
# Dit bestand ís de deelsysteemversie: het pint welke microserviceversies er samen in
# gaan. De compose ernaast is de chart en verandert hier niet van; deployen is chart plus
# deze release plus de waarden van de omgeving.
#
# Een release is onveranderlijk. Wijzigt er een microservice, dan komt er een nieuwe
# release naast deze — net als bij een contract in het register.

DEELSYSTEEM=order
DEELSYSTEEM_VERSIE=1.0.0

ORDER_API_VERSIE=1.0.0
