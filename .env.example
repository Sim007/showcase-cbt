# Kopieer naar .env en pas aan waar nodig. .env staat in .gitignore.
#
# Er staan hier geen secrets, en dat is geen toeval: het register kent geen authenticatie
# en de deelsystemen hebben geen inloggegevens nodig. Zodra dat verandert, hoort de waarde
# hier als lege plek te staan en de invulling in .env — nooit in code, yaml of compose.

# Welke versie van een deelsysteem er draait. Eén build is één versie, en die image gaat
# ongewijzigd door alle omgevingen: dit zegt wat er draait, niet hoe de tag heet.
PAYMENT_API_VERSIE=1.0.0
ORDER_API_VERSIE=1.0.0

# Waar Order zijn buur zoekt. Binnen het compose-netwerk is dat de servicenaam, ook als de
# stub die naam overneemt — de consumer merkt het verschil niet, en dat is het punt.
PAYMENT_BASE_URL=http://payment-api:8081

# Poorten op de host. Alleen nodig als er iets anders op die poort draait.
PAYMENT_API_POORT=8081
ORDER_API_POORT=8082
STUB_POORT=8081

# Waar de gegenereerde stubmappings staan. Wordt door ci/generate-stub.sh gevuld.
STUB_MAPPINGS=./build/stub

# Het register.
REGISTRY_URL=http://localhost:8080
